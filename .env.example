# 系统级配置（也可用 config.toml 的 [server] 段）
LOG_LEVEL=info
WEB_PORT=8080
DB_CLEANUP_DAYS=30
DB_VACUUM_INTERVAL=24

# 可选：Clash 外部控制器密钥。仅当某数据源的「凭据引用」填了 CLASH_SECRET 时生效；
# 也可以不设这里，改在 /data-sources 页直接填写密钥（混淆后存数据表）。
CLASH_SECRET=your_secret

# 注意：数据源定义（Clash / IPFIX 地址、端口、LAN 网段、阈值等）不在环境变量里，
# 请在网页 /data-sources 页添加与管理。全新部署初始 0 数据源，页面会给出空表引导。

# 环境变量文件
.env

# Node 依赖（仅用于编译前端样式）
node_modules/

# 构建产物目录：本地构建与 CI 交叉编译都输出到 dist/
# 本地测试运行也建议在该目录下执行，运行时生成的 data/ 会落在 dist/data/，
# 这样项目根目录只留源码，不会被数据库、日志和二进制污染
dist/

# 数据库文件
*.db
*.db-shm
*.db-wal

# 日志文件
*.log
*.log.*

# 编译产物（直接 go build 不带 -o 时会落在根目录，这里兜底忽略）
clash-statistics
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试文件
*.test
*.out

# Go 工作目录
vendor/

# IDE 配置文件
.vscode/
.idea/
.trae/
*.swp
*.swo
*~

# 操作系统文件
.DS_Store
Thumbs.db

# 数据目录
data/

# 临时文件
tmp/
temp/